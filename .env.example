APP_NAME="OWL Delivery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# Production: use "warning". LOG_LEVEL=debug writes on every request.
LOG_LEVEL=debug

# Performance instrumentation (see config/performance.php).
# Requests slower than the threshold are logged with their query count and
# how much of the time was spent in MySQL versus PHP.
LOG_SLOW_REQUESTS=true
SLOW_REQUEST_THRESHOLD_MS=500
SLOW_QUERY_THRESHOLD_MS=200
# How long a computed dashboard payload is reused, in seconds.
DASHBOARD_CACHE_TTL=300
# Lifetime of rarely changing lookup lists (active cities). Also flushed on write.
REFERENCE_CACHE_TTL=3600

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=speedzone_corporate
DB_USERNAME=root
DB_PASSWORD=

# Separate database used only by PHPUnit (see phpunit.xml).
# Create it once in MySQL: CREATE DATABASE speedzone_corporate_testing;
DB_TEST_DATABASE=speedzone_corporate_testing

BROADCAST_DRIVER=log
# Set to pusher (or reverb) for real-time notifications. Requires queue worker.
# BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# "database" costs one SELECT plus one write per request. On a single server,
# "file" is faster; with Redis available, "redis" is faster still.
# Changing this invalidates every existing session (all users are logged out).
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — use "log" for local debugging (emails go to storage/logs/laravel.log only).
# Production: set MAIL_MAILER=smtp and fill SMTP credentials from your hosting provider.
MAIL_MAILER=smtp
MAIL_HOST=mail.oowlmedia.com
MAIL_PORT=587
MAIL_USERNAME=noreply@oowlmedia.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@oowlmedia.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TEST_TO=

# AI assistant (chatbot widget). Which provider answers: gemini | openai
# Leaving the active provider's key empty hides the widget instead of breaking it.
AI_DRIVER=gemini

# --- Google Gemini — https://aistudio.google.com/apikey
# Keys are issued in the "AQ." format; legacy "AIzaSy" keys work too.
GEMINI_API_KEY=
# gemini-3.6-flash is stronger but its free tier allows only 5 requests/minute.
GEMINI_MODEL=gemini-3.5-flash-lite
# low | medium | high — how much the model may reason before answering.
GEMINI_THINKING_LEVEL=low

# --- OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Only needed on accounts that scope usage per organisation / project.
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
# Any model with tool-calling support.
OPENAI_MODEL=gpt-4o-mini

CHATBOT_ENABLED=true
AI_TIMEOUT=45
# Completion round-trips allowed per user message (each one is a batch of tool calls).
CHATBOT_MAX_TOOL_ROUNDS=4
# Assistant messages per minute, per user.
CHATBOT_RATE_LIMIT=20

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
